#include <windows.h>
#include "resource.h"
#pragma code_page(65001)

// RightMenuXShell.dll 的版本信息（无 RT_MANIFEST：故意不带提权清单，
// 这样才能被 Explorer 作为进程内 COM 服务器正常加载）。
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,3,260724
PRODUCTVERSION 1,0,3,260724
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "重庆持玛多网络科技有限公司"
            VALUE "FileDescription", "RightMenuX Shell Server"
            VALUE "FileVersion", "1.0.3.20260724"
            VALUE "InternalName", "RightMenuXShell"
            VALUE "LegalCopyright", "持玛多网络 / Z.W."
            VALUE "OriginalFilename", "RightMenuXShell.dll"
            VALUE "ProductName", "RightMenuX"
            VALUE "ProductVersion", "1.0.3.20260724"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
